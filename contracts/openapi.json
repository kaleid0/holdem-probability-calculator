{
  "components": {
    "schemas": {
      "AnalysisRequest": {
        "additionalProperties": false,
        "properties": {
          "board": {
            "items": {
              "maximum": 51.0,
              "minimum": 0.0,
              "type": "integer"
            },
            "maxItems": 5,
            "title": "Board",
            "type": "array"
          },
          "call_amount": {
            "default": 50,
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Call Amount",
            "type": "integer"
          },
          "dead_cards": {
            "items": {
              "maximum": 51.0,
              "minimum": 0.0,
              "type": "integer"
            },
            "maxItems": 45,
            "title": "Dead Cards",
            "type": "array"
          },
          "hero": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "maximum": 51.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "maximum": 51.0,
                "minimum": 0.0,
                "type": "integer"
              }
            ],
            "title": "Hero",
            "type": "array"
          },
          "opponents": {
            "items": {
              "discriminator": {
                "mapping": {
                  "exact": "#/components/schemas/ExactOpponent",
                  "random": "#/components/schemas/RandomOpponent"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/RandomOpponent"
                },
                {
                  "$ref": "#/components/schemas/ExactOpponent"
                }
              ]
            },
            "maxItems": 8,
            "minItems": 1,
            "title": "Opponents",
            "type": "array"
          },
          "pot_before_call": {
            "default": 150,
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Pot Before Call",
            "type": "integer"
          },
          "samples": {
            "default": 20000,
            "maximum": 200000.0,
            "minimum": 1000.0,
            "title": "Samples",
            "type": "integer"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "seed": {
            "default": 42,
            "maximum": 4294967295.0,
            "minimum": 0.0,
            "title": "Seed",
            "type": "integer"
          },
          "settlement_assumption": {
            "default": "futureBettingPossible",
            "enum": [
              "showdownAfterCall",
              "futureBettingPossible"
            ],
            "title": "Settlement Assumption",
            "type": "string"
          },
          "strategy_config": {
            "additionalProperties": true,
            "title": "Strategy Config",
            "type": "object"
          },
          "strategy_id": {
            "default": "pot-odds",
            "title": "Strategy Id",
            "type": "string"
          }
        },
        "required": [
          "hero",
          "opponents"
        ],
        "title": "AnalysisRequest",
        "type": "object"
      },
      "AnalysisResult": {
        "additionalProperties": false,
        "properties": {
          "assumptions": {
            "items": {
              "type": "string"
            },
            "title": "Assumptions",
            "type": "array"
          },
          "break_even_equity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Break Even Equity"
          },
          "call_ev": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Call Ev"
          },
          "elapsed_ms": {
            "title": "Elapsed Ms",
            "type": "number"
          },
          "engine_version": {
            "default": "0.1.0",
            "title": "Engine Version",
            "type": "string"
          },
          "equity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Equity"
          },
          "equity_standard_error": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Equity Standard Error"
          },
          "lose_probability": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lose Probability"
          },
          "method": {
            "anyOf": [
              {
                "enum": [
                  "exact",
                  "monteCarlo"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Method"
          },
          "pot_odds_ratio": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pot Odds Ratio"
          },
          "recommendation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recommendation"
          },
          "sample_count": {
            "title": "Sample Count",
            "type": "integer"
          },
          "scenario_hash": {
            "title": "Scenario Hash",
            "type": "string"
          },
          "seed": {
            "title": "Seed",
            "type": "integer"
          },
          "strategy": {
            "$ref": "#/components/schemas/StrategyIdentity"
          },
          "tie_probability": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tie Probability"
          },
          "win_probability": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Win Probability"
          }
        },
        "required": [
          "method",
          "win_probability",
          "tie_probability",
          "lose_probability",
          "equity",
          "equity_standard_error",
          "sample_count",
          "elapsed_ms",
          "pot_odds_ratio",
          "break_even_equity",
          "call_ev",
          "recommendation",
          "assumptions",
          "strategy",
          "scenario_hash",
          "seed"
        ],
        "title": "AnalysisResult",
        "type": "object"
      },
      "ExactOpponent": {
        "additionalProperties": false,
        "properties": {
          "cards": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "maximum": 51.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "maximum": 51.0,
                "minimum": 0.0,
                "type": "integer"
              }
            ],
            "title": "Cards",
            "type": "array"
          },
          "kind": {
            "const": "exact",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "cards"
        ],
        "title": "ExactOpponent",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "RandomOpponent": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "random",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "title": "RandomOpponent",
        "type": "object"
      },
      "StrategyIdentity": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "version"
        ],
        "title": "StrategyIdentity",
        "type": "object"
      },
      "StrategyList": {
        "additionalProperties": false,
        "properties": {
          "strategies": {
            "items": {
              "$ref": "#/components/schemas/StrategyManifest"
            },
            "title": "Strategies",
            "type": "array"
          }
        },
        "required": [
          "strategies"
        ],
        "title": "StrategyList",
        "type": "object"
      },
      "StrategyManifest": {
        "additionalProperties": false,
        "properties": {
          "api_version": {
            "default": 1,
            "title": "Api Version",
            "type": "integer"
          },
          "capabilities": {
            "additionalProperties": true,
            "title": "Capabilities",
            "type": "object"
          },
          "config_schema": {
            "additionalProperties": true,
            "title": "Config Schema",
            "type": "object"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "version",
          "description",
          "config_schema",
          "capabilities"
        ],
        "title": "StrategyManifest",
        "type": "object"
      },
      "TaskCreated": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "queued",
              "running",
              "cancelling",
              "succeeded",
              "failed",
              "cancelled",
              "expired"
            ],
            "title": "Status",
            "type": "string"
          },
          "task_id": {
            "title": "Task Id",
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "status"
        ],
        "title": "TaskCreated",
        "type": "object"
      },
      "TaskSnapshot": {
        "additionalProperties": false,
        "properties": {
          "completed_samples": {
            "title": "Completed Samples",
            "type": "integer"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "progress": {
            "title": "Progress",
            "type": "number"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnalysisResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "cancelling",
              "succeeded",
              "failed",
              "cancelled",
              "expired"
            ],
            "title": "Status",
            "type": "string"
          },
          "task_id": {
            "title": "Task Id",
            "type": "string"
          },
          "total_samples": {
            "title": "Total Samples",
            "type": "integer"
          }
        },
        "required": [
          "task_id",
          "status",
          "progress",
          "completed_samples",
          "total_samples"
        ],
        "title": "TaskSnapshot",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "单底池权益与策略分析。任务为单实例内存存储，重启后失效。",
    "title": "德州扑克概率计算器 API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/analyses": {
      "post": {
        "operationId": "submit_analysis_api_v1_analyses_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskCreated"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Submit Analysis"
      }
    },
    "/api/v1/analyses/{task_id}": {
      "get": {
        "operationId": "get_analysis_api_v1_analyses__task_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "title": "Task Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskSnapshot"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Analysis"
      }
    },
    "/api/v1/analyses/{task_id}/cancel": {
      "post": {
        "operationId": "cancel_analysis_api_v1_analyses__task_id__cancel_post",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "title": "Task Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskSnapshot"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cancel Analysis"
      }
    },
    "/api/v1/strategies": {
      "get": {
        "operationId": "strategies_api_v1_strategies_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategyList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Strategies"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  }
}
